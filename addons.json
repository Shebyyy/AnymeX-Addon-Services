{
  "name": "AnymeX Official Addon Services",
  "version": 1,
  "description": "Community tracking and metadata services repository for AnymeX",
  "addons": [
    {
      "id": "kitsu",
      "name": "Kitsu",
      "version": "1.0.3",
      "author": "Sheby",
      "description": "Track and discover anime and manga on Kitsu.io",
      "icon": "https://kitsu.io/favicon.ico",
      "color": "#FD6585",
      "capabilities": [
        "anime",
        "manga"
      ],
      "auth_type": "credentials",
      "manifest_url": "https://raw.githubusercontent.com/Shebyyy/AnymeX-Addon-Services/main/services/kitsu.json"
    },
    {
      "id": "mangabaka",
      "name": "MangaBaka",
      "version": "1.0.1",
      "author": "Sheby",
      "description": "Track and discover manga on MangaBaka with OAuth2 support",
      "icon": "https://mangabaka.org/favicon.ico",
      "color": "#101828",
      "capabilities": [
        "manga"
      ],
      "auth_type": "oauth2",
      "manifest_url": "https://raw.githubusercontent.com/Shebyyy/AnymeX-Addon-Services/main/services/mangabaka.json"
    },
    {
      "id": "shikimori",
      "name": "Shikimori",
      "version": "1.0.1",
      "author": "Sheby",
      "description": "Track anime and manga on Shikimori.one with OAuth2 support",
      "icon": "https://shikimori.one/favicon.ico",
      "color": "#3282B8",
      "capabilities": [
        "anime",
        "manga"
      ],
      "auth_type": "oauth2",
      "manifest_url": "https://raw.githubusercontent.com/Shebyyy/AnymeX-Addon-Services/main/services/shikimori.json"
    }
  ]
}
